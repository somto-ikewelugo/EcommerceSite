@{
    ViewData["Title"] = "Home - E-Commerce";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="hero">
    <div class="hero-content">
        <h1>Welcome to ShopEase</h1>
        <p>Your one-stop shop for all your fashion and tech needs!</p>
        <a href="/Products" class="btn-primary">Shop Now</a>
    </div>
</section>

<section class="features">
    <div class="feature-card">
        <img src="data:image/jpeg;base64," alt="Free Shipping">
        <h3>Free Shipping</h3>
        <p>Enjoy free shipping on orders above $50.</p>
    </div>
    <div class="feature-card">
        <img src="data:image/jpeg;base64," alt="Quality Products">
        <h3>Premium Quality</h3>
        <p>We offer only the best quality products.</p>
    </div>
    <div class="feature-card">
        <img src="data:image/png;base64," alt="Support">
        <h3>24/7 Support</h3>
        <p>Our support team is always here for you.</p>
    </div>
</section>

<section class="categories">
    <h2>Shop by Category</h2>
    <div class="category-grid">
        <div class="category-card">
            <img src="data:image/png;base64," alt="Fashion">
            <a href="/Products/Fashion">Fashion</a>
        </div>
        <div class="category-card">
            <img src="data:image/png;base64," alt="Electronics">
            <a href="/Products/Electronics">Electronics</a>
        </div>
        <div class="category-card">
            <img src="data:image/png;base64," alt="Home Appliances">
            <a href="/Products/HomeAppliances">Home Appliances</a>
        </div>
    </div>
</section>

